# ── Running a second instance ────────────────────────────────────────────────
# Every *_PORT here is published on the host by docker-compose, and compose
# falls back to the value in compose.yaml for anything left unset. So a second
# instance sharing a machine with the first (the Alice/Bob federation pair)
# must override every one of them — POSTGRES_PORT, REDIS_PORT, RUSTFS_PORT,
# RUSTFS_CONSOLE_PORT, MAILPIT_SMTP_PORT, MAILPIT_UI_PORT — or `make
# <instance>-docker` aborts with "port is already allocated" once the other
# stack is up. The IdP runs with host networking and derives DATABASE_URL,
# REDIS_URL and STORAGE_ENDPOINT from these same values, so overriding the port
# is enough; the URLs follow.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# These are used by both the postgres container and to build DATABASE_URL.
POSTGRES_USER=pina
POSTGRES_PASSWORD=secret
POSTGRES_DB=identity_provider
POSTGRES_PORT=5432

# Full connection string used by the application (localhost for direct dev, overridden in Docker)
DATABASE_URL=postgres://pina:secret@localhost:5432/identity_provider

# ── Server ────────────────────────────────────────────────────────────────────
# The domain this IdP is hosted on (no scheme). e.g. "localhost:8080" or "idp.example.com"
DOMAIN=localhost:8080
PORT=8080

# ── Keys ─────────────────────────────────────────────────────────────────────
# One Ed25519 key per instance, generated on first run and never regenerated.
# It signs JWTs, federation HTTP Signatures and E2EE device attestations, so two
# instances sharing one would make every cross-instance check pass regardless of
# whether key resolution works. Losing it cannot be recovered from: back this
# directory up together with the database.
#
# IDP_KEYS_DIR is the host directory compose mounts; JWT_PRIVATE_KEY_PATH is the
# same key as the host process sees it (resolved against the repo root).
IDP_KEYS_DIR=./identity-provider/keys/default
JWT_PRIVATE_KEY_PATH=./identity-provider/keys/default/ed25519.pem
JWT_KEY_ID=key-2025-01

# ── Session ───────────────────────────────────────────────────────────────────
# At least 32 bytes; production refuses to start on this placeholder. Signs
# session cookies and attachment URLs. `make <instance>-env` generates it,
# or: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-secret-in-production-000000000000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL of the web-client — used to redirect to the hosted login page
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins (no trailing slashes)
# Defaults to localhost dev URLs when unset
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Redis (Message Broker) ────────────────────────────────────────────────────
# Redis Streams for durable event delivery (DMs, friend requests, profile updates)
# and pub-sub for ephemeral presence events (online/offline/typing).
REDIS_URL=redis://127.0.0.1:6379

# Host port for the bundled Redis container (docker-compose only — the IdP
# reads REDIS_URL above, which compose rebuilds from this port).
REDIS_PORT=6379

# ── Object Storage (S3-compatible — RustFS / MinIO) ──────────────────────────
# All three of STORAGE_ENDPOINT / STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY must
# be set, otherwise the avatar + attachment endpoints return 500
# "Object storage not configured". Start the bundled RustFS via:
#   docker compose up -d rustfs
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
# Optional — externally-reachable base URL used to build public avatar URLs.
# Falls back to STORAGE_ENDPOINT when unset (fine for local dev).
# STORAGE_PUBLIC_URL=http://localhost:9000
# Optional — bucket names. Defaults: "avatars" and "attachments".
# STORAGE_BUCKET_AVATARS=avatars
# STORAGE_BUCKET_ATTACHMENTS=attachments

# ── RustFS (Object Storage) ports ────────────────────────────────────────────
# Used only by docker-compose; the IdP itself reads STORAGE_ENDPOINT above.
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ── Outbound email (SMTP) ────────────────────────────────────────────────────
# Defaults match the bundled Mailpit container. For production point at a real
# SMTP relay (SES, SendGrid, Mailgun, self-hosted Postfix — anything reachable
# at host:port). SMTP_STARTTLS=true for any TLS-enabled relay.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Pīna'i <no-reply@localhost>"
SMTP_STARTTLS=false
# Optional — host port overrides for the bundled Mailpit container.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# HMAC pepper for email OTP and TOTP recovery code hashes — required, ≥ 32 bytes
# hex. `make <instance>-env` generates it, or: openssl rand -hex 32
# Replacing it invalidates every stored recovery code: back it up with the database.
EMAIL_OTP_PEPPER=

# ── Chat server ──────────────────────────────────────────────────────────────
# The chat server is attached to this IdP and deploys with it. Its port must not
# collide with PORT above.
# CHAT_PORT=8081
# CHAT_POSTGRES_DB=chat_server
# The IdP the chat server is attached to. Rooms are addressed under it and its
# JWTs are the only ones accepted; federation is server-to-server, not more issuers.
# IDP_ISSUER=http://localhost:8080

# ── Logging ───────────────────────────────────────────────────────────────────
# Standard RUST_LOG filter string. Use LOG_FORMAT=json for structured prod logs.
RUST_LOG=info
# LOG_FORMAT=json
