# Copy this file to .env beside compose.yaml, fill it in, then `chmod 600 .env`:
# it holds passwords. The secrets are generated in ./data/secrets at the first
# start, never here.

# ── Instance ──────────────────────────────────────────────────────────────────
# The domain the instance is reached at, without scheme or path. Its DNS must
# point at this server, with ports 80 and 443 open, for Caddy to get a certificate.
# It names every account (alice_xk9mp@DOMAIN): it cannot change later.
DOMAIN=
# Shown on the sign-in pages and in NodeInfo until an admin changes them in
# Settings → Instance; the domain when unset. At most 40 and 90 characters.
# INSTANCE_NAME=
# INSTANCE_DESCRIPTION=

# ── Who can join ──────────────────────────────────────────────────────────────
# invite: only people an admin invites can join. Needs the first admin below; the
# mail relay is optional. open: anyone can sign up, confirming their address with
# a mailed code. Needs the mail relay below.
REGISTRATIONS=invite
# The first admin, created at the first start when no account has the address;
# an existing account is never overwritten. Remove ADMIN_PASSWORD once the admin
# exists: the instance warns at each start while it is here.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Outbound email ────────────────────────────────────────────────────────────
# The SMTP relay: needed for open, optional for invite, where an empty SMTP_HOST
# means no mail at all. README.md lists some relays. SMTP_PORT is 587 when
# empty; SMTP_TLS is tls on port 465 and starttls on any other when empty.
# SMTP_FROM is "Pīna'i <no-reply@HOST>" when empty, HOST being DOMAIN without
# its port. The identity provider checks the relay on every start and logs
# whether it can mail (docker compose logs idp).
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Optional ──────────────────────────────────────────────────────────────────
# The Pīna'i web app's address (https://…), where invitations and reset pages send
# people; unset, they end on a page that says to sign in.
# WEB_APP_ORIGIN=
# Where users get the code this instance runs; Pīna'i's repository when unset.
# Point it at your fork if you modify the code: the AGPL requires offering it.
# SOURCE_URL=
# The image version. Unset, compose.yaml runs the latest release of its minor
# version and `docker compose pull` gets its fixes. Set it to pin an exact
# release (X.Y.Z), or to `edge`, the main branch, for testing only.
# PINAI_VERSION=
# Every other variable the identity provider reads (attachment limits, logging…)
# can be set here too; the repository's .env.example lists them.
# RUST_LOG=info
