# ./setup.sh copies this file to .env, asks for the values left empty and generates
# the secrets. Back .env up with ./data: the secrets cannot be recovered.

# ── Instance ──────────────────────────────────────────────────────────────────
# The image version. Pin the minor (0.1) to get its fixes on `docker compose pull`;
# `edge` follows the main branch, for testing only.
PINAI_VERSION=0.1
# The domain the instance is reached at, without scheme or path. Its DNS must
# point at this server, with ports 80 and 443 open, for Caddy to get a certificate.
# It names every account (alice_xk9mp@DOMAIN): it cannot change later.
DOMAIN=
# Shown on the sign-in pages and in NodeInfo; the domain when unset.
# At most 60 and 280 characters.
# INSTANCE_NAME=
# INSTANCE_DESCRIPTION=

# ── Outbound email ────────────────────────────────────────────────────────────
# Sign-up codes are mailed, so an instance needs an SMTP relay. Port 587 with
# STARTTLS; implicit TLS (465) is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Generated by ./setup.sh: never change them ───────────────────────────────
# The instance key's id, in every JWT and device attestation.
JWT_KEY_ID=
# Signs session cookies and attachment links; changing it signs everyone out.
SESSION_SECRET=
# Hashes email codes and TOTP recovery codes; changing it breaks every recovery code.
EMAIL_OTP_PEPPER=
POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Every other variable the identity provider reads (attachment limits, logging…)
# can be set here too; the repository's .env.example lists them.
# RUST_LOG=info
