# syntax=docker/dockerfile:1.7
#
# Development Dockerfile — debug build, fast incremental rebuilds.
#
# Same cargo-chef layout as the production Dockerfile, but compiles in debug
# profile (faster rebuilds, slower runtime). Use this for the inner dev loop:
#
#   docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d --build
#
# Cache-mount IDs are versioned (-v1) — bump after big workspace restructures.

# ── Cargo-chef base ──────────────────────────────────────────────────────────
FROM rust:bookworm AS chef
RUN cargo install cargo-chef --locked
WORKDIR /build

# ── Recipe extraction ────────────────────────────────────────────────────────
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo chef prepare --recipe-path recipe.json

# ── Build (debug profile) ────────────────────────────────────────────────────
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json

RUN --mount=type=cache,id=idp-cargo-registry-v1,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=idp-cargo-git-v1,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY migrations/ migrations/
RUN --mount=type=cache,id=idp-cargo-registry-v1,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=idp-cargo-git-v1,target=/usr/local/cargo/git,sharing=locked \
    cargo build -p idp-server && \
    cp target/debug/idp-server /idp-server

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /idp-server /app/idp-server

# Default RUST_LOG bumped to debug so you can see what the IdP is doing.
ENV RUST_LOG=info,idp_auth=debug,idp_presence=debug,idp_federation=debug,idp_messaging=debug,idp_social=debug

EXPOSE 8080
CMD ["/app/idp-server"]
