# syntax=docker/dockerfile:1.7
#
# Development Dockerfile — debug build, fast incremental rebuilds.
#
# Same cargo-chef layout as the production Dockerfile, but compiles in debug
# profile (faster rebuilds, slower runtime). Selected by compose.dev.yml and
# compose-win.dev.yml; start it through the Makefile, which also seeds the database:
#
#   make alice-docker        # bob-docker, or alice-docker-win / bob-docker-win on Windows
#
# Cache-mount IDs are versioned (-v2) — bump after big workspace restructures.

# ── Cargo-chef base ──────────────────────────────────────────────────────────
FROM lukemathwalker/cargo-chef:0.1.78-rust-1.98.1-trixie AS chef
WORKDIR /build

# ── Recipe extraction ────────────────────────────────────────────────────────
FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY identity-provider/crates/ identity-provider/crates/
RUN cargo chef prepare --recipe-path recipe.json

# ── Build (debug profile) ────────────────────────────────────────────────────
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json

RUN --mount=type=cache,id=idp-cargo-registry-v2,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=idp-cargo-git-v2,target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --recipe-path recipe.json

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY identity-provider/crates/ identity-provider/crates/
COPY identity-provider/migrations/ identity-provider/migrations/
RUN --mount=type=cache,id=idp-cargo-registry-v2,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=idp-cargo-git-v2,target=/usr/local/cargo/git,sharing=locked \
    cargo build -p idp-app --bin idp-server && \
    cp target/debug/idp-server /idp-server

# ── Runtime ──────────────────────────────────────────────────────────────────
# Runs as root, unlike the production image: it reads the keys `make <instance>-keys`
# writes on the host, readable by their owner only.
FROM debian:trixie-slim AS runtime

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /idp-server /app/idp-server

# Default RUST_LOG bumped to debug for every IdP crate. Targets are lib names (`api`, not `idp_api`).
ENV RUST_LOG=info,domain=debug,application=debug,infrastructure=debug,connections=debug,api=debug,app=debug,idp_server=debug

EXPOSE 8080
CMD ["/app/idp-server"]
